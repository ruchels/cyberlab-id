# ==============================================================================
# CyberLab-ID — Environment Configuration Template
# ==============================================================================
# Copy this template to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT:
# - NEVER commit .env or .env.local files containing real credentials to Git.
# - All keys below use safe local defaults or placeholder tokens.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cryptographic Session & Auth Secret
# Generate a new random secret: openssl rand -hex 32
SESSION_SECRET=cyberlab_development_mock_session_secret_32bytes_min

# SQLite Database Storage Location (Default: data/cyberlab.db)
DATABASE_PATH=./data/cyberlab.db

# AI Assistant Provider Configuration (Optional)
# If provided, enables live real-time LLM responses in the AI Tutor & SOC Assistant.
# Default fallback uses evidence-grounded rule-based local models if unset.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Cyber Range Virtual Lab Execution Engine
# 'auto' automatically detects Docker/Podman availability; falls back to sandbox.
CONTAINER_RUNTIME=auto
DOCKER_HOST=
RANGE_MAX_CONCURRENT_SESSIONS=10
RANGE_DEFAULT_SESSION_TIMEOUT_MINUTES=60

# Rate Limiting & Abuse Prevention Controls
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
CTF_SUBMIT_RATE_LIMIT_MAX=20
CTF_SUBMIT_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_WINDOW_MS=60000

# Logging & Observability
LOG_LEVEL=info
