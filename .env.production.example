# ==============================================================================
# CyberLab-ID — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.production on your production server.
# NEVER commit actual secrets to version control.

# Node Environment
NODE_ENV=production
PORT=3000

# Base URL (Used for notifications, redirects, and canonical metadata)
NEXT_PUBLIC_APP_URL=https://cyberlab.id

# Production Session & Auth Secrets (Must be 32+ cryptographically random bytes)
# Generate via: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_SECURE_64_CHAR_HEX_SECRET_IN_PRODUCTION

# Database Storage Path (Mounted volume directory)
DATABASE_PATH=/app/data/cyberlab.db

# Cyber Range Container Configuration
# Set to 'unix:///var/run/docker.sock' if Docker daemon is mounted
DOCKER_HOST=unix:///var/run/docker.sock
RANGE_MAX_CONCURRENT_SESSIONS=50
RANGE_DEFAULT_SESSION_TIMEOUT_MINUTES=60

# Rate Limiting & Abuse Prevention
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
CTF_SUBMIT_RATE_LIMIT_MAX=10
CTF_SUBMIT_RATE_LIMIT_WINDOW_MS=60000

# Security Telemetry & Log Level (debug, info, warn, error)
LOG_LEVEL=info
